# ============================================================
#  BIFlow — .env.example
#  Copier vers .env et remplir les valeurs réelles
#  NE PAS committer .env sur Git
# ============================================================

# Shared LLM client (agents/llm_client.py): ollama | gemini | groq | cloud
# Local by default: the profiling agent never falls back to a cloud provider on its own
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional Gemini configuration for the profiling agent only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Password-reset email (required only when using "Forgot your password?")
BIFLOW_SMTP_HOST=
BIFLOW_SMTP_PORT=587
BIFLOW_SMTP_FROM=
BIFLOW_SMTP_USE_SSL=false
BIFLOW_SMTP_USER=
BIFLOW_SMTP_PASSWORD=

# Optional local SQLite database location
# BIFLOW_AUTH_DB=

# Isolated generated-cleaning experiments (build sandbox/Dockerfile first)
BIFLOW_EXPERIMENT_IMAGE=biflow-cleaning-sandbox:latest
# Seconds to wait for Docker API replies; Docker Desktop can be slow while busy or waking from Resource Saver
BIFLOW_DOCKER_TIMEOUT=30

# Cleaning agent: local Ollama only (independent of profiling's LLM_PROVIDER)
BIFLOW_CLEANING_OLLAMA_HOST=http://localhost:11434
BIFLOW_CLEANING_OLLAMA_MODEL=qwen2.5:7b
BIFLOW_OLLAMA_TIMEOUT=90
BIFLOW_OLLAMA_NUM_CTX=8192
BIFLOW_OLLAMA_NUM_PREDICT=2048
# Thinking models (qwen3) spend most of each request on hidden reasoning; leave off unless evaluating it
BIFLOW_OLLAMA_THINK=false
# Minimum run turns; the limit grows to TURNS_PER_TASK x the number of cleaning tasks
BIFLOW_CLEANING_MAX_TURNS=24
BIFLOW_CLEANING_TURNS_PER_TASK=3
# Minimum run seconds; the limit grows to SECONDS_PER_TASK x the number of cleaning tasks
BIFLOW_CLEANING_MAX_SECONDS=300
BIFLOW_CLEANING_SECONDS_PER_TASK=30
# A task is dropped (and reported for review) after this many turns or distinct failed methods
BIFLOW_CLEANING_TASK_MAX_TURNS=6
BIFLOW_CLEANING_TASK_MAX_FAILURES=4

GROQ_API_KEY=
# Groq model for the BI Analyst / XAI agents in cloud mode
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
HF_TOKEN=

# Groq authors a replacement only after four failed local corrections.
BIFLOW_CLEANING_EXPERT_ENABLED=false
BIFLOW_CLEANING_EXPERT_MODEL=openai/gpt-oss-120b
BIFLOW_CLEANING_EXPERT_MAX_CALLS=2
BIFLOW_CLEANING_EXPERT_TIMEOUT=60
# Groq tokens per minute for the model, and how many are reserved for its reply
BIFLOW_CLEANING_EXPERT_TOKEN_LIMIT=8000
BIFLOW_CLEANING_EXPERT_MAX_COMPLETION_TOKENS=2000
