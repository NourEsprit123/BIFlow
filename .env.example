# Local Ollama defaults
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional Gemini configuration for the profiling agent only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Password-reset email (required only when using "Forgot your password?")
BIFLOW_SMTP_HOST=
BIFLOW_SMTP_PORT=587
BIFLOW_SMTP_FROM=
BIFLOW_SMTP_USE_SSL=false
BIFLOW_SMTP_USER=
BIFLOW_SMTP_PASSWORD=

# Optional local SQLite database location
# BIFLOW_AUTH_DB=

# Isolated generated-cleaning experiments (build sandbox/Dockerfile first)
BIFLOW_EXPERIMENT_IMAGE=biflow-cleaning-sandbox:latest

# Cleaning agent: local Ollama only (independent of profiling's LLM_PROVIDER)
BIFLOW_CLEANING_OLLAMA_HOST=http://localhost:11434
BIFLOW_CLEANING_OLLAMA_MODEL=qwen2.5:7b
BIFLOW_OLLAMA_TIMEOUT=90
BIFLOW_OLLAMA_NUM_CTX=8192
BIFLOW_OLLAMA_NUM_PREDICT=2048
BIFLOW_CLEANING_MAX_TURNS=24
BIFLOW_CLEANING_MAX_SECONDS=300

GROQ_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Groq authors a replacement only after four failed local corrections.
BIFLOW_CLEANING_EXPERT_ENABLED=false
BIFLOW_CLEANING_EXPERT_MODEL=openai/gpt-oss-120b
BIFLOW_CLEANING_EXPERT_MAX_CALLS=2
BIFLOW_CLEANING_EXPERT_TIMEOUT=60
