# Local Ollama defaults
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional Groq configuration for the data-cleaning agent
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Password-reset email (required only when using "Forgot your password?")
BIFLOW_SMTP_HOST=
BIFLOW_SMTP_PORT=587
BIFLOW_SMTP_FROM=
BIFLOW_SMTP_USE_SSL=false
BIFLOW_SMTP_USER=
BIFLOW_SMTP_PASSWORD=

# Optional local SQLite database location
# BIFLOW_AUTH_DB=

# Isolated generated-cleaning experiments (build sandbox/Dockerfile first)
BIFLOW_EXPERIMENT_IMAGE=biflow-cleaning-sandbox:latest

# Cleaning provider: auto tries Groq first, then local Ollama.
# Use ollama to run locally from the start; profiling keeps its own LLM_PROVIDER.
BIFLOW_CLEANING_PROVIDER=auto
BIFLOW_OLLAMA_FALLBACK=true
BIFLOW_CLEANING_OLLAMA_HOST=http://localhost:11434
BIFLOW_CLEANING_OLLAMA_MODEL=qwen2.5:7b
BIFLOW_OLLAMA_TIMEOUT=180
