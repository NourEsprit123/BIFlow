# PostgreSQL connection used after Apply recommended cleaning.
# Example for a local PostgreSQL installation:
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/biflow
POSTGRES_SCHEMA=analytics

# LLM used by BIFlow to generate the cleaning recommendations.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
