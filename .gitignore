# =============================================================================
# BIFlow — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Environnements virtuels ───────────────────────────────────────────────────
.venv/
venv/
env/
.env_cache/

# ── Secrets & Variables d'environnement (JAMAIS committer) ───────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.secret
*.key

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Tests & Couverture ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Logs & fichiers temporaires ───────────────────────────────────────────────
*.log
*.tmp
*.temp
logs/
temp/

# ── Données générées par le pipeline (ne pas versionner les outputs) ──────────
data/cleaned/
data/processed/
data/reports/
!data/reports/.gitkeep

# ── Mocks & données synthétiques temporaires ─────────────────────────────────
# Les mocks sont écrits dans /tmp — rien à ignorer ici
# Mais on ignore les exports locaux éventuels
mock_outputs/

# ── Modèles IA & poids lourds (>100 MB — utiliser Git LFS si besoin) ─────────
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.ggml
adapter/adapter_model.safetensors
adapter/tokenizer.json
models/

# ── Sandboxes Docker (outputs générés à l'exécution) ─────────────────────────
sandbox/data_input/*
!sandbox/data_input/.gitkeep
sandbox/reports_output/*
!sandbox/reports_output/.gitkeep
sandbox_xai/reports_output/*
!sandbox_xai/reports_output/.gitkeep

# ── Rapports d'audit générés ──────────────────────────────────────────────────
*_transformation_log.json
*_profiling_report.json
*_audit_*.json

# ── SQLite (auth local) ───────────────────────────────────────────────────────
data/biflow_auth.sqlite3*
*.sqlite3
*.db

# ── Artefacts de build ────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/
